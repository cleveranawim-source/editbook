# 로컬 개발(README 참고)
DATABASE_URL=postgresql://postgres:editbook@localhost:5432/editbook
ADMIN_LOGIN_ID=admin
# 운영에서는 예시 값·8자 미만을 거부합니다. 첫 로그인 때 바꾸게 되지만 처음부터 긴 값을 쓰세요.
ADMIN_PASSWORD=change-me-now

# 운영(docker-compose.prod.yml)에서만 쓰는 값. DATABASE_URL은 자동으로 만들어집니다.
# POSTGRES_PASSWORD=아무도-모르는-긴-문자열
# APP_PORT=3000
