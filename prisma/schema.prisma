// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String       @id @default(cuid())
  loginId            String       @unique
  name               String
  passwordHash       String
  isAdmin            Boolean      @default(false)
  mustChangePassword Boolean      @default(true)
  createdAt          DateTime     @default(now())
  sessions           Session[]
  memberships        BookMember[]
  assignedParts      Part[]
  uploadedVersions   Version[]
  editRequests       EditRequest[]
  editComments       EditRequestComment[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum BookStatus {
  ACTIVE
  ARCHIVED
}

enum BookRole {
  EDITOR
  AUTHOR
}

model Book {
  id        String       @id @default(cuid())
  title     String
  status    BookStatus   @default(ACTIVE)
  createdAt DateTime     @default(now())
  members   BookMember[]
  parts     Part[]
}

model BookMember {
  bookId String
  userId String
  role   BookRole
  book   Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookId, userId])
}

model Part {
  id             String  @id @default(cuid())
  bookId         String
  order          Int
  title          String
  note           String  @default("")
  assigneeUserId String?
  book           Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  assignee       User?   @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull)
  versions       Version[]
  requests       EditRequest[]
  /// 편집장이 "이 파트 완료"를 누른 버전. 최신 버전과 같을 때만 완료로 본다(새 버전이 오르면 저절로 풀림).
  completedVersionId String?

  @@unique([bookId, order])
}

/// 파트에 올린 원고 한 벌. 번호는 파트 안에서 1부터 올라가고 덮어쓰기는 없다.
/// ref는 저장 위치 표시자: Vercel Blob이면 https 주소, 로컬 디스크면 "local:<경로>".
model Version {
  id           String   @id @default(cuid())
  partId       String
  number       Int
  originalRef  String
  originalName String
  originalSize Int
  pdfRef       String?
  pdfName      String?
  note         String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  requests     EditRequest[]
  comments     EditRequestComment[]

  @@unique([partId, number])
}

enum EditRequestKind {
  /// 편집장이 담당 교사에게 남기는 수정 요청
  REQUEST
  /// 담당 교사가 편집장에게 남기는 질문
  QUESTION
}

enum EditRequestStatus {
  /// 요청됨(교사 차례) / 질문(편집장 차례)
  OPEN
  /// 교사가 응답함(편집장 확인 차례) — 요청만
  RESPONDED
  /// 편집장이 확인 완료 — 요청만
  RESOLVED
  /// 편집장이 답함 — 질문만
  ANSWERED
}

enum EditCommentAction {
  NOTE
  RESPOND
  RESOLVE
  REREQUEST
  ANSWER
}

/// 미리보기의 한 쪽 위에 그린 영역 + 메모. 좌표는 쪽 크기 대비 비율(0~1).
model EditRequest {
  id         String            @id @default(cuid())
  partId     String
  versionId  String
  number     Int
  kind       EditRequestKind
  status     EditRequestStatus @default(OPEN)
  page       Int
  x          Float
  y          Float
  w          Float
  h          Float
  body       String
  authorId   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  part       Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  version    Version           @relation(fields: [versionId], references: [id], onDelete: Restrict)
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments   EditRequestComment[]

  @@unique([partId, number])
  @@index([partId, status])
}

model EditRequestComment {
  id        String            @id @default(cuid())
  requestId String
  authorId  String?
  body      String            @default("")
  action    EditCommentAction @default(NOTE)
  /// 새 버전으로 응답했을 때 그 버전
  versionId String?
  createdAt DateTime          @default(now())
  request   EditRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  version   Version?          @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

/// 앱 안 알림함 한 줄. url은 누르면 갈 곳(파트 편집실의 그 요청 등).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String    @default("")
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// 기기 하나의 웹 푸시 구독.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 앱 전체 설정(웹 푸시 VAPID 키처럼 한 번 만들어 계속 쓰는 값).
model AppSetting {
  key   String @id
  value String
}
