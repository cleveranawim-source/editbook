// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String       @id @default(cuid())
  loginId            String       @unique
  name               String
  passwordHash       String
  isAdmin            Boolean      @default(false)
  mustChangePassword Boolean      @default(true)
  createdAt          DateTime     @default(now())
  sessions           Session[]
  memberships        BookMember[]
  assignedParts      Part[]
  uploadedVersions   Version[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum BookStatus {
  ACTIVE
  ARCHIVED
}

enum BookRole {
  EDITOR
  AUTHOR
}

model Book {
  id        String       @id @default(cuid())
  title     String
  status    BookStatus   @default(ACTIVE)
  createdAt DateTime     @default(now())
  members   BookMember[]
  parts     Part[]
}

model BookMember {
  bookId String
  userId String
  role   BookRole
  book   Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookId, userId])
}

model Part {
  id             String  @id @default(cuid())
  bookId         String
  order          Int
  title          String
  note           String  @default("")
  assigneeUserId String?
  book           Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  assignee       User?   @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull)
  versions       Version[]

  @@unique([bookId, order])
}

/// 파트에 올린 원고 한 벌. 번호는 파트 안에서 1부터 올라가고 덮어쓰기는 없다.
/// ref는 저장 위치 표시자: Vercel Blob이면 https 주소, 로컬 디스크면 "local:<경로>".
model Version {
  id           String   @id @default(cuid())
  partId       String
  number       Int
  originalRef  String
  originalName String
  originalSize Int
  pdfRef       String?
  pdfName      String?
  note         String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([partId, number])
}
